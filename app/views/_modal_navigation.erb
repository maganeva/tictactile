<div class="w3-row w3-center w3-xlarge" style="padding-bottom: 20px;">
  <% if previous_project.nil? and next_project.nil? %>
    <span class="modal-nav-disabled"
      onclick="onDisabledModalClick(event);"
    >❮</span></span><span class="modal-nav-disabled"
      onclick="onDisabledModalClick(event);"
    >❯</span>
  <% elsif previous_project.nil? %>
    <span class="modal-nav-disabled"
      onclick="onDisabledModalClick(event);"
    >❮</span><span class="modal-nav"
      onclick="onNextModalClick(event, '<%= section %>', '<%= project[:item_anchor] %>', '<%= next_project[:item_anchor] %>');"
    >❯</span>
  <% elsif next_project.nil? %>
    <span class="modal-nav"
      onclick="onNextModalClick(event, '<%= section %>', '<%= project[:item_anchor] %>', '<%= previous_project[:item_anchor] %>');"
    >❮</span><span class="modal-nav-disabled"
      onclick="onDisabledModalClick(event);"
    >❯</span>
  <% else %>
    <span class="modal-nav"
      onclick="onNextModalClick(event, '<%= section %>', '<%= project[:item_anchor] %>', '<%= previous_project[:item_anchor] %>');"
    >❮</span><span class="modal-nav"
      onclick="onNextModalClick(event, '<%= section %>', '<%= project[:item_anchor] %>', '<%= next_project[:item_anchor] %>');"
    >❯</span>
  <% end %>
</div>