
<div id="box4">
	<div class="wrapper">
		<h2 style="font-size: 20px; padding-top: 2em; padding-bottom: 1em;  font-family: myFirstFont;">digital</h2>


	<% @digital.each.with_index do |proj, index| %>	
	<div class='icon'>
			<img style="width:10em; cursor:pointer" src=<%=proj[:thumbnail]%>
			onclick="document.getElementById('modal19<%=index%>').style.display='inline'" class="w3-hover-opacity">
	 	</div><div id="modal19<%=index%>" class="w3-modal" onclick="this.style.display='none'">
			<span class="w3-button w3-hover-red w3-xlarge w3-display-topright">&times;</span>
			<div class="w3-modal-content w3-animate-zoom">
				<img id="img01" src=<%=proj[:image]%> style="width:100%; max-height: 100%">
				<p style="font-family: myFirstFont; color: grey; background-color: black; margin-top: 0px;"><%=proj[:title]%><p>
			</div>
	</div>  
	<%end%>


	</div>
</div>

